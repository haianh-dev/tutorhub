# =============================================================================
# TutorHub Environment Variables Template (.env.example)
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit real secrets or credentials into version control!
# =============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tutorhub
DB_USER=tutorhub_user
DB_PASSWORD=tutorhub_password
DB_URL=jdbc:postgresql://localhost:5432/tutorhub

# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Backend Server Configuration
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080

# Security & JWT Configuration
# Generate a strong 256-bit or 512-bit key for production (e.g., openssl rand -base64 64)
JWT_SECRET=your-256-bit-secret-your-256-bit-secret-must-be-long-enough-32-bytes
JWT_ACCESS_TTL=900000        # 15 minutes (in milliseconds)
JWT_REFRESH_TTL=604800000    # 7 days (in milliseconds)

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1
